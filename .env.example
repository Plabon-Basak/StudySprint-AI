# StudySprint AI — environment variables
# Copy this file to `.env` and fill in your own values, then keep `.env` private.
# The real `.env` is ignored by git and must never be committed.

# Your free Google AI Studio API key (used from Slice 3 onward).
GEMINI_API_KEY=your-google-ai-studio-key

# Which Gemini model to use. Kept configurable so it can be changed without
# editing the application code.
GEMINI_MODEL=gemini-flash-latest
